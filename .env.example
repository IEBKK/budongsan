# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding). 국토부 실거래가 API 공통.
MOLIT_SERVICE_KEY=

# 온비드 공매 API 키 (M3에서 사용)
ONBID_SERVICE_KEY=

# 지오코딩용 (둘 중 하나만 있어도 됨). 없으면 시군구 중심좌표로 근사한다.
VWORLD_KEY=
KAKAO_REST_KEY=

# 수집 대상 시군구 코드(5자리) 콤마 구분. 비우면 seed/regions.json 전체.
TARGET_REGIONS=

# 최근 N개월 롤링 재수집 (DATA-03)
ROLLING_MONTHS=3

# 산출물 경로
OUT_DIR=web/public/data
